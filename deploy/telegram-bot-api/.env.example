# Create .env from this file and fill values from https://my.telegram.org/apps.
# These are Telegram application credentials, not the BotFather bot token.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Keep local mode enabled for larger bot uploads.
TELEGRAM_LOCAL=1

# Optional local stats endpoint on 127.0.0.1:8082.
TELEGRAM_STAT=1
TELEGRAM_VERBOSITY=2
