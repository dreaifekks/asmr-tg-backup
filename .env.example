# Match the host user so a mode-0600 config.toml remains readable in the app
# container. Run `id -u` and `id -g` if your account does not use 1000.
PUID=1000
PGID=1000

# Use the GHCR release as-is, or set asmr-tg-backup:local and build the source
# target with `docker compose build asmr-tg-backup`.
ASMR_TG_BACKUP_IMAGE=ghcr.io/dreaifekks/asmr-tg-backup:latest

# App delivery credentials. Keep the real .env at mode 0600.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_channel
ASMR_TG_UPLOAD_TRANSPORT=mtproto

# Direct MTProto is the default upload transport in official releases. Leave
# these empty to use the official-release defaults, or set both to use your own
# Telegram application credentials. Source builds require a complete pair.
ASMR_TG_MTPROTO_API_ID=
ASMR_TG_MTPROTO_API_HASH=

# Advanced Bot API transport settings. The official cloud endpoint uses the
# 49 MB safety limit and playable audio splitting as its fallback behavior.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_MAX_UPLOAD_BYTES=49000000

# Required only by `docker compose --profile local-api up`. These configure the
# Bot API server and are separate from ASMR_TG_MTPROTO_API_ID/HASH above.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_API_IMAGE=aiogram/telegram-bot-api:latest
TELEGRAM_BOT_API_PORT=18081
TELEGRAM_BOT_API_STATS_PORT=18082

# Optional Twitch credentials.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_CLIENT_SECRET=
